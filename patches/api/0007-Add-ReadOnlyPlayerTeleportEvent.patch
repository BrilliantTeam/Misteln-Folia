diff --git a/src/main/java/rice/chen/event/player/ReadOnlyPlayerTeleportEvent.java b/src/main/java/rice/chen/event/player/ReadOnlyPlayerTeleportEvent.java
new file mode 100644
index 0000000000000000000000000000000000000000..3e35f2f0b65e31941064ddeb463d98f8fde2d35b
--- /dev/null
+++ b/src/main/java/rice/chen/event/player/ReadOnlyPlayerTeleportEvent.java
@@ -0,0 +1,88 @@
+package rice.chen.event.player;
+
+import io.papermc.paper.entity.TeleportFlag;
+import java.util.Collections;
+import java.util.Set;
+import org.bukkit.Location;
+import org.bukkit.entity.Player;
+import org.bukkit.event.HandlerList;
+import org.bukkit.event.player.PlayerMoveEvent;
+import org.bukkit.event.player.PlayerTeleportEvent;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+import org.jetbrains.annotations.ApiStatus.Internal;
+
+public class ReadOnlyPlayerTeleportEvent extends PlayerMoveEvent {
+   private static final HandlerList handlers = new HandlerList();
+   private PlayerTeleportEvent.TeleportCause cause = PlayerTeleportEvent.TeleportCause.UNKNOWN;
+   private boolean dismounted = true;
+   private final Set<TeleportFlag.Relative> teleportFlagSet;
+
+   public ReadOnlyPlayerTeleportEvent(@NotNull Player player, @NotNull Location from, @Nullable Location to) {
+      super(player, from, to);
+      this.teleportFlagSet = Collections.emptySet();
+   }
+
+   public ReadOnlyPlayerTeleportEvent(@NotNull Player player, @NotNull Location from, @Nullable Location to, @NotNull PlayerTeleportEvent.TeleportCause cause) {
+      this(player, from, to);
+      this.cause = cause;
+   }
+
+   @Internal
+   public ReadOnlyPlayerTeleportEvent(
+      @NotNull Player player,
+      @NotNull Location from,
+      @Nullable Location to,
+      @NotNull PlayerTeleportEvent.TeleportCause cause,
+      @NotNull Set<TeleportFlag.Relative> teleportFlagSet
+   ) {
+      super(player, from, to);
+      this.teleportFlagSet = teleportFlagSet;
+      this.cause = cause;
+   }
+
+   @NotNull
+   public PlayerTeleportEvent.TeleportCause getCause() {
+      return this.cause;
+   }
+
+   @Deprecated(forRemoval = true)
+   public boolean willDismountPlayer() {
+      return this.dismounted;
+   }
+
+   @NotNull
+   public Set<TeleportFlag.Relative> getRelativeTeleportationFlags() {
+      return this.teleportFlagSet;
+   }
+
+   @NotNull
+   @Override
+   public HandlerList getHandlers() {
+      return handlers;
+   }
+
+   @NotNull
+   public static HandlerList getHandlerList() {
+      return handlers;
+   }
+
+   @Override
+   public void setCancelled(boolean cancel) {
+      throw new UnsupportedOperationException("This is an read-only event!");
+   }
+
+   public static enum TeleportCause {
+      ENDER_PEARL,
+      COMMAND,
+      PLUGIN,
+      NETHER_PORTAL,
+      END_PORTAL,
+      SPECTATE,
+      END_GATEWAY,
+      CHORUS_FRUIT,
+      DISMOUNT,
+      EXIT_BED,
+      UNKNOWN;
+   }
+}
