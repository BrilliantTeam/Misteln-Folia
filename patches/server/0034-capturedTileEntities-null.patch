@@ -461,20 +461,25 @@ public class LevelChunk extends ChunkAccess implements ca.spottedleaf.moonrise.p
     @Nullable
     public BlockEntity getBlockEntity(BlockPos pos, LevelChunk.EntityCreationType creationType) {
         // CraftBukkit start
-        BlockEntity tileentity = this.level.getCurrentWorldData().capturedTileEntities.get(pos); // Folia - region threading
+        final io.papermc.paper.threadedregions.RegionizedWorldData _worldData = this.level.getCurrentWorldData(); // Folia - region threading
+        BlockEntity tileentity = _worldData != null ? _worldData.capturedTileEntities.get(pos) : null;
         if (tileentity == null) {
             tileentity = (BlockEntity) this.blockEntities.get(pos);
         }
         // CraftBukkit end
 
         if (tileentity == null) {
-            CompoundTag nbttagcompound = (CompoundTag) this.pendingBlockEntities.remove(pos);
