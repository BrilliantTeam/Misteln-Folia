From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RICE0707 <master.end.9377@gmail.com>
Date: Fri, 22 May 2026 08:34:53 +0800
Subject: [PATCH] purpur-port: Configurable advancement broadcast settings


diff --git a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
index d7ba88f8b3e380392717b5a283c9f2cfa4d14325..7265a803741542dd1ad42b483e2765e9d7aab0dc 100644
--- a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
+++ b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
@@ -360,4 +360,13 @@ public class GlobalConfiguration extends ConfigurationPart {
         }
     }
     // Folia end - threaded regions
-}
+    // purpur-port start
+    public PurpurPort purpurPort;
+
+    public class PurpurPort extends ConfigurationPart {
+        @Comment("If true, advancement completion messages are only sent to the player who earned the advancement instead of broadcasting to all players.")
+        public boolean advancementOnlyBroadcastToAffectedPlayer = false;
+    }
+    // purpur-port end
+
+}
\ No newline at end of file
diff --git a/src/main/java/net/minecraft/server/PlayerAdvancements.java b/src/main/java/net/minecraft/server/PlayerAdvancements.java
index c7e1f2bac3eca9bb72bf1f8c26cccb2905e1ddfc..64c567dad97755d3cb945ae48e1140f66eb1538a 100644
--- a/src/main/java/net/minecraft/server/PlayerAdvancements.java
+++ b/src/main/java/net/minecraft/server/PlayerAdvancements.java
@@ -249,7 +249,11 @@ public class PlayerAdvancements {
                 advancement.value().display().ifPresent((advancementdisplay) -> {
                     // Paper start - Add Adventure message to PlayerAdvancementDoneEvent
                     if (event.message() != null && this.player.level().getGameRules().getBoolean(GameRules.RULE_ANNOUNCE_ADVANCEMENTS)) {
+                        if (io.papermc.paper.configuration.GlobalConfiguration.get().purpurPort.advancementOnlyBroadcastToAffectedPlayer) { // purpur-port
+                            this.player.sendSystemMessage(io.papermc.paper.adventure.PaperAdventure.asVanilla(event.message())); // purpur-port
+                        } else { // purpur-port
                         this.playerList.broadcastSystemMessage(io.papermc.paper.adventure.PaperAdventure.asVanilla(event.message()), false);
+                        } // purpur-port
                         // Paper end
                     }
 
@@ -426,4 +430,4 @@ public class PlayerAdvancements {
             });
         }
     }
-}
+}
\ No newline at end of file
