From: RICE0707 <master.end.9377@gmail.com>
Date: Sat, 19 Sep 2026 10:53:18 +0800
Subject: [PATCH] purpur-port: Configurable chest Open With Block On Top


diff --git a/net/minecraft/world/level/block/ChestBlock.java b/net/minecraft/world/level/block/ChestBlock.java
index 4b3f5c92f3caf6d68f60b906d1f7eb552698ef05..ba410aedd4b076611f4db4425cb0deb5855552f6 100644
--- a/net/minecraft/world/level/block/ChestBlock.java
+++ b/net/minecraft/world/level/block/ChestBlock.java
@@ -334,6 +334,7 @@ public class ChestBlock extends AbstractChestBlock<ChestBlockEntity> implements
     }
 
     private static boolean isBlockedChestByBlock(final BlockGetter level, final BlockPos pos) {
+        if (io.papermc.paper.configuration.GlobalConfiguration.get().purpurPort.chestOpenWithBlockOnTop) return false; // purpur-port
         BlockPos above = pos.above();
         return level.getBlockState(above).isRedstoneConductor(level, above);
     }
