diff --git a/net/minecraft/world/level/storage/DimensionDataStorage.java b/net/minecraft/world/level/storage/DimensionDataStorage.java
index ab572ac18fd02306210c87eb9ba5e5d4197ff997..f5d1ab12d715da85b226528616f271823f1045da 100644
--- a/net/minecraft/world/level/storage/DimensionDataStorage.java
+++ b/net/minecraft/world/level/storage/DimensionDataStorage.java
@@ -198,6 +198,34 @@ public class DimensionDataStorage implements AutoCloseable {
         this.scheduleSave().join();
     }
 
+    // Folia start - autosave map data
+    // maps are already safe to save off the owning region, other saved data is not
+    public CompletableFuture<?> saveMaps() {
+        Map<Path, CompoundTag> map = new Object2ObjectArrayMap<>();
+        synchronized (this.cache) {
+            this.cache.forEach(
+                (string, optional) -> optional.filter(savedData -> savedData.isDirty()
+                        && (savedData instanceof net.minecraft.world.level.saveddata.maps.MapItemSavedData || savedData instanceof net.minecraft.world.level.saveddata.maps.MapIndex))
+                    .ifPresent(savedData -> map.put(this.getDataFile(string), savedData.save(this.registries)))
+            );
+        }
+        if (map.isEmpty()) {
+            return CompletableFuture.completedFuture(null);
+        }
+
+        this.pendingWriteFuture = this.pendingWriteFuture
+            .thenCompose(
+                object -> CompletableFuture.allOf(
+                    map.entrySet()
+                        .stream()
+                        .map(entry -> CompletableFuture.runAsync(() -> tryWrite(entry.getKey(), entry.getValue()), Util.DIMENSION_DATA_IO_POOL))
+                        .toArray(CompletableFuture[]::new)
+                )
+            );
+        return this.pendingWriteFuture;
+    }
+    // Folia end - autosave map data
+
     @Override
     public void close() {
         this.saveAndJoin();
