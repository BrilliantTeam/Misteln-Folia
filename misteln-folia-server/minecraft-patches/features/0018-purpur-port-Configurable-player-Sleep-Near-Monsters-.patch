Subject: [PATCH] purpur-port: Configurable player Sleep Near Monsters settings


diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 7d6c97e8d6e56cdb5543b12ae39834d4fadd3e5b..a4a7773cae52f8e7fbc23c757bf764b2a1e2ff86 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -2191,7 +2191,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
                         new AABB(bedCenter.x() - 8.0, bedCenter.y() - 5.0, bedCenter.z() - 8.0, bedCenter.x() + 8.0, bedCenter.y() + 5.0, bedCenter.z() + 8.0),
                         monster -> monster.isPreventingPlayerRest(this.level(), this)
                     );
-                if (!monsters.isEmpty()) {
+                if (!io.papermc.paper.configuration.GlobalConfiguration.get().purpurPort.playerSleepNearMonsters && !monsters.isEmpty()) { // purpur-port
                     return Either.left(Player.BedSleepingProblem.NOT_SAFE);
                 }
             }
