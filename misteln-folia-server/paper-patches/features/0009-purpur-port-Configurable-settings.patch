From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RICE0707 <master.end.9377@gmail.com>
Date: Tue, 15 Sep 2026 12:17:54 +0800
Subject: [PATCH] purpur-port: Configurable settings


diff --git a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
index 8835cf8d9d1fb3b4930a50d002e0b426b155f4ac..def77daf3ca5072939b1837b113b6f89d981cf6e 100644
--- a/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
+++ b/src/main/java/io/papermc/paper/configuration/GlobalConfiguration.java
@@ -418,4 +418,28 @@ public class GlobalConfiguration extends ConfigurationPart {
         }
     }
     // Folia end - threaded regions
+    // purpur-port start
+    public PurpurPort purpurPort;
+
+    public class PurpurPort extends ConfigurationPart {
+        @Comment("If true, advancement completion messages are only sent to the player who earned the advancement instead of broadcasting to all players.")
+        public boolean advancementOnlyBroadcastToAffectedPlayer = false;
+        @Comment("If true, beacon effects will apply even when the beacon beam is blocked by tinted glass.")
+        public boolean beaconAllowEffectsWithTintedGlass = false;
+        @Comment("If true, chests can be opened even when a solid block is on top.")
+        public boolean chestOpenWithBlockOnTop = false;
+        @Comment("If true, death messages are only sent to the player who died instead of broadcasting to all players.")
+        public boolean deathMessageOnlyBroadcastToAffectedPlayer = false;
+        @Comment("If true, minecarts can be placed on any block, not just rails.")
+        public boolean minecartPlaceAnywhere = false;
+        @Comment("If true, nether wart can be grown by using bone meal.")
+        public boolean netherWartAffectedByBonemeal = false;
+        @Comment("If true, players can sleep even when monsters are nearby.")
+        public boolean playerSleepNearMonsters = false;
+        @Comment("If true, sneaking players can break individual slabs from a double slab, dropping the other half.")
+        public boolean slabHalfBreak = false;
+        @Comment("If true, sponges will absorb lava in addition to water.")
+        public boolean spongeAbsorbsLava = false;
+    }
+    // purpur-port end
 }
